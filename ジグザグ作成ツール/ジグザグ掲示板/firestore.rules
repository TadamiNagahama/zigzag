rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- メインツール用のルール ---
    // puzzles: ownerId フィールドで本人確認
    match /puzzles/{puzzleId} {
      allow read, write: if request.auth != null && (
        resource == null || 
        resource.data.ownerId == request.auth.uid || 
        request.resource.data.ownerId == request.auth.uid
      );
    }
    // userSettings: userId フィールドで本人確認
    match /userSettings/{settingId} {
      allow read, write: if request.auth != null && (
        resource == null || 
        resource.data.userId == request.auth.uid || 
        request.resource.data.userId == request.auth.uid
      );
    }

    // --- 掲示板用のルール ---
    // users: プロフィールの作成と読み取り（ログイン必須。管理者は他人のデータも変更可能）
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    // threads / comments: 承認済みユーザーのみ
    match /threads/{threadId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update, delete: if isApproved() && (resource.data.authorId == request.auth.uid || isAdmin());
    }
    match /comments/{commentId} {
      allow read: if isApproved();
      allow create: if isApproved();
      allow update, delete: if isApproved() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    // ヘルパー関数
    function isApproved() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
